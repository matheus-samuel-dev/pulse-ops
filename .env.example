# Local one-command defaults. Copy to .env only when you need to override them.
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=55432

BACKEND_PORT=18083
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=dev

# At least 32 characters. Generate a unique random value for every environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=pulseops
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
MONITORING_INTERVAL_MS=60000
MONITORING_ENABLED=false
MONITORING_INITIAL_DELAY_MS=300000
MONITORING_CONCURRENCY=4
MONITORING_QUEUE_CAPACITY=256
MONITORING_ALLOW_PRIVATE_NETWORKS=false

# Safe defaults for a public portfolio demo. Set both to false in a private writable environment.
DEMO_READ_ONLY=true
VITE_DEMO_MODE=true

# Integration bindings reuse Systems. Without an ID, the exact catalogue name is used.
# Register base URL, health path, timeout and expected HTTP code in Systems (ADMIN).
# Public URLs below only enable external navigation; never include credentials or query strings.
INTEGRATIONS_STALE_AFTER=PT5M
INTEGRATIONS_CHECK_COOLDOWN=PT1M
INTEGRATIONS_REPORTING_ZONE=America/Sao_Paulo
AI_WEB_AUDITOR_SYSTEM_ID=
AI_WEB_AUDITOR_URL=
ARENA_PREDICT_SYSTEM_ID=
ARENA_PREDICT_URL=
PLAYSPACE_SYSTEM_ID=
PLAYSPACE_URL=
LOGITRACK_SYSTEM_ID=
LOGITRACK_URL=
HELPDESK_SYSTEM_ID=
HELPDESK_URL=
HOSPITAL_SYSTEM_ID=
HOSPITAL_URL=

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom
