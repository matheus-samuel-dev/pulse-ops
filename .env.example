# Local one-command defaults. Copy to .env only when you need to override them.
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=55432

BACKEND_PORT=18083
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=dev

# At least 32 characters. Generate a unique random value for every environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTEGRATIONS_ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=pulseops
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
MONITORING_INTERVAL_MS=10000
MONITORING_ENABLED=true
MONITORING_INITIAL_DELAY_MS=5000
MONITORING_CONCURRENCY=4
MONITORING_QUEUE_CAPACITY=256
MONITORING_ALLOW_PRIVATE_NETWORKS=false

# Ambiente normal: dados reais e escritas habilitadas. Demo exige perfil e banco separados.
DEMO_READ_ONLY=false
VITE_DEMO_MODE=false

# Conexões da conta são configuradas pela interface em Integrações.
# Variáveis abaixo preservam somente vínculos legados; novos usuários não herdam cadastros pelo nome.
# Cadastre URL base, endpoint, timeout e HTTP esperado em Sistemas.
# Public URLs below only enable external navigation; never include credentials or query strings.
INTEGRATIONS_STALE_AFTER=PT5M
INTEGRATIONS_CHECK_COOLDOWN=PT1M
INTEGRATIONS_REPORTING_ZONE=America/Sao_Paulo

JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom

# Apenas perfil demo em banco separado. Nunca habilite em produção.
DEMO_SEED_ENABLED=false
